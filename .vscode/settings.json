{
  // These settings are here for convenience and to ensure a consistent dev experience
  // This configuration aims to be as minimal as possible.
  // Use the ".vscode/settings.local.json" file to override settings defined here
  //
  // These settings are here for convenience and to ensure a consistent dev experience
  // This configuration aims to be as minimal as possible.
  "phpsab.snifferShowSources": true,
  "editor.rulers": [80, 120],
  "[php]": {
    "editor.defaultFormatter": "valeryanm.vscode-phpsab",
  },
  "[javascript][vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  // Drupal file associations
  "files.associations": {
    "*.inc": "php",
    "*.module": "php",
    "*.install": "php",
    "*.theme": "php",
    "*.profile": "php",
    "*.tpl.php": "php",
    "*.test": "php",
    "*.php": "php",
    "*.info": "ini",
  },
  // Add rulers as visual indicator for lint warning threshold and error threshold
  // Please do try to keep it under warning threshold as that allows having
  // multiple editor window side by side while seeing the whole code and not
  // needing word-wrap (makes it easier to see in all editors, prevents mistakes
  // in contexts where line breaks are important)
  "editor.rulers": [80, 120],

  // PHP Intelephense basic configuration
  "php.suggest.basic": false,
  "intelephense.completion.suggestObjectOperatorStaticMethods": false,
  "intelephense.environment.shortOpenTag": false,
  "intelephense.environment.includePaths": [
    "core/",
    "core/includes",
    "../vendor/",
  ],

  // PHP Docblocker configuration
  "php-docblocker.gap": true,
  "php-docblocker.useShortNames": true,
  "php-docblocker.defaultType": "mixed",
  "php-docblocker.paramDescription": true,
  "php-docblocker.returnDescription": true,

  // Allow Emmet to work within twig files
  "emmet.includeLanguages": {
    "twig": "html"
  },

  // Deviating from drupal recommentations

  // This is very annoying at least while not all configuration is done
  // properly, running the formatter should be intentional and a responsibility
  // of the developer
  "editor.formatOnPaste": false,

  // Drupal recommended configuration (+- what's already configured or up to final user)
  "breadcrumbs.enabled": true,
  "css.validate": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.tabSize": 2,
  "editor.autoIndent": "full",
  "editor.insertSpaces": true,
  "editor.formatOnSave": false,
  "editor.renderWhitespace": "boundary",
  "editor.wordWrapColumn": 80,
  "editor.wordWrap": "off",
  "editor.detectIndentation": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "html.format.enable": true,
  "html.format.wrapLineLength": 80,
  "cSpell.words": [
    "autoload",
    "codesniffer",
    "dealerdirect",
    "devel",
    "drupal",
    "drush",
    "gofast",
    "phpcbf",
    "phpcodesniffer",
    "phpcs",
    "phpstan",
    "restui",
    "slevomat",
    "squizlabs",
    "symfony",
    "webform"
  ],
  // Use the ".vscode/settings.local.json" file to override settings defined here
  //
  // These settings are here for convenience and to ensure a consistent dev experience
  // This configuration aims to be as minimal as possible.
  "jest.runMode": {
    "type": "on-demand",
    "coverage": true,
    "showInlineError": true,
  },
}